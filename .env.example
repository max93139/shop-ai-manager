# Database
DATABASE_URL=postgresql://user:password@localhost:5433/shop_ai

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_CHANNEL_ID=
# Staff chat (or user) id that gets a message for every new order; leave empty to disable
TELEGRAM_MANAGER_CHAT_ID=

# API Service
PORT=4000
API_URL=http://localhost:4000
JWT_SECRET=

# Admin Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Nova Poshta API
NOVA_POSHTA_API_KEY=
# Ref of the Nova Poshta warehouse parcels are sent from (AddressGeneral.getWarehouses -> Ref)
NOVA_POSHTA_SENDER_WAREHOUSE_REF=
# Default parcel weight in kg when the admin does not pass one
NOVA_POSHTA_DEFAULT_WEIGHT=1

# Monobank acquiring (payment links in the bot); leave empty to offer cash on delivery only
MONOBANK_TOKEN=
# Public HTTPS address of this API, used as the Monobank webhook base (…/payments/monobank/webhook)
API_PUBLIC_URL=
