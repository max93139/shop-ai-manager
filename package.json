{
  "name": "shop-ai-manager",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "db:generate": "pnpm --filter @shop-ai/database db:generate",
    "db:push": "pnpm --filter @shop-ai/database db:push",
    "db:seed": "pnpm --filter @shop-ai/database db:seed",
    "db:studio": "pnpm --filter @shop-ai/database db:studio"
  },
  "devDependencies": {
    "@shop-ai/config": "workspace:*",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
