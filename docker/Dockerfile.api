FROM node:20-alpine
RUN apk add --no-cache openssl && corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

# The whole workspace is copied (see .dockerignore) so the frozen lockfile matches every project.
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm db:generate
RUN pnpm exec turbo run build --filter=@shop-ai/api...

ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000

CMD ["node", "apps/api/dist/main.js"]
