FROM node:20-alpine
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile

# Next.js inlines NEXT_PUBLIC_* at build time, so the API address is a build argument.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm exec turbo run build --filter=@shop-ai/admin...

ENV NODE_ENV=production
EXPOSE 3001

CMD ["pnpm", "--filter", "@shop-ai/admin", "start"]
